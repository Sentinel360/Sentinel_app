rules_version = '2';

// Sentinel360 — client rules for authenticated users.
// Cloud Functions use the Admin SDK and bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function tripOwnedByUser(tripId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/trips/$(tripId)) &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
    }

    // ── User profile & emergency contacts ─────────────────────────────
    match /users/{userId} {
      allow read, write: if isSelf(userId);

      match /emergency_contacts/{contactId} {
        allow read, write: if isSelf(userId);
      }
    }

    // ── Registered devices (document has userId) ─────────────────────
    match /devices/{deviceId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Trips (top-level userId) ───────────────────────────────────────
    match /trips/{tripId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /sensor_data/{eventId} {
        allow read: if tripOwnedByUser(tripId);
        allow create: if tripOwnedByUser(tripId) &&
          request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      match /current_state/{docId} {
        allow read: if tripOwnedByUser(tripId);
        allow write: if tripOwnedByUser(tripId);
      }

      match /alerts/{alertId} {
        allow read, create: if tripOwnedByUser(tripId);
        allow update, delete: if tripOwnedByUser(tripId);
      }
    }

    // ── Trip escalations (doc id == tripId; Functions also write) ─────
    match /trip_escalations/{tripId} {
      allow read, write: if tripOwnedByUser(tripId);
    }

    // ── Emergency alerts (document has userId) ───────────────────────
    match /emergency_alerts/{alertId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Post-trip feedback (document has userId) ─────────────────────
    match /trip_feedback/{feedbackId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
