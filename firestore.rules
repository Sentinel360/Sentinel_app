rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Users — each user can only read/write their own document
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Emergency contacts subcollection — owner only
      match /emergency_contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Safety prompt notifications written by Cloud Functions —
      // the app reads these to surface the safety-check dialog.
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ---------------------------------------------------------------
    // Devices — owner only
    // ---------------------------------------------------------------
    match /devices/{deviceId} {
      allow read, write: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // ---------------------------------------------------------------
    // Trips — owner read/write; admin can read all
    // ---------------------------------------------------------------
    match /trips/{tripId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Sensor data sub-collection — owner only
      match /sensor_data/{eventId} {
        allow read, write: if request.auth != null;
      }

      // Current state — written exclusively by Cloud Functions and the ML
      // service via Admin SDK (which bypasses these rules).
      // The mobile app initialises this doc via TripManager.startTrip() which
      // runs as the trip owner, so we allow write only for the trip owner.
      match /current_state/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && resource == null
          && get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid;
      }

      // Alerts sub-collection — Cloud Functions write most alerts,
      // but the mobile app writes SOS_MANUAL alerts via TripManager.triggerSOS()
      match /alerts/{alertId} {
        allow read, write: if request.auth != null;
      }
    }

    // ---------------------------------------------------------------
    // Emergency alerts — user can create, admin can read all
    // ---------------------------------------------------------------
    match /emergency_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Trip escalations — Cloud Functions create/update (admin SDK),
    // but the app needs to READ the doc (SafetyCheckListener dialog)
    // and WRITE userResponse ("OK" / "NOT_OK") back to it.
    //
    // IMPORTANT: resource is null when the document does not yet exist.
    // SafetyCheckListener subscribes to this path as soon as a trip starts
    // (before the Cloud Function has created the doc). Allowing read on a
    // non-existent document (resource == null) is safe — there is nothing
    // to read — and it keeps the real-time listener alive so it receives
    // the snapshot the moment the Cloud Function creates the document.
    // ---------------------------------------------------------------
    match /trip_escalations/{tripId} {
      allow read: if request.auth != null
        && (resource == null || resource.data.userId == request.auth.uid);
      // Clients may only update (write userResponse back) — never create.
      // Creation is done exclusively by Cloud Functions via Admin SDK.
      allow update: if request.auth != null
        && resource != null
        && resource.data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // Trip feedback — write-once per user per trip
    // ---------------------------------------------------------------
    match /trip_feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || request.auth.token.admin == true);
    }

    // ---------------------------------------------------------------
    // Escalation timers — Cloud Functions only (admin SDK bypasses rules)
    // Admin dashboard can read
    // ---------------------------------------------------------------
    match /escalation_timers/{timerId} {
      allow read: if request.auth != null
        && request.auth.token.admin == true;
    }

    // ---------------------------------------------------------------
    // Admin notifications — admin read only
    // ---------------------------------------------------------------
    match /admin_notifications/{notifId} {
      allow read: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}
